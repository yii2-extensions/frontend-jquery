{
    "name": "yii2-extensions/frontend-jquery",
    "type": "yii2-scaffold",
    "description": "jQuery + Bootstrap 5 frontend overlay for app-base, distributed via scaffold.",
    "keywords": [
        "yii2",
        "scaffold",
        "jquery",
        "bootstrap5",
        "frontend"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.3",
        "yii2-extensions/app-base": "^0.1@dev",
        "yii2-extensions/scaffold": "^0.1@dev",
        "yiisoft/yii2": "^22.0@dev",
        "yiisoft/yii2-bootstrap5": "^22.0@dev",
        "yiisoft/yii2-jquery": "^1.0@dev"
    },
    "require-dev": {
        "maglnet/composer-require-checker": "^4.6",
        "php-forge/coding-standard": "^0.1",
        "php-forge/foxy":"^0.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "^2.0.3",
        "phpunit/phpunit": "^12.4",
        "yii2-extensions/phpstan": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "app\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "app\\tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "scaffold": {
            "manifest": "scaffold.json"
        }
    },
    "config": {
        "allow-plugins": {
            "php-forge/foxy": true,
            "phpstan/extension-installer": true,
            "yii2-extensions/scaffold": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check-dependencies": "./vendor/bin/composer-require-checker check",
        "ecs": "./vendor/bin/ecs --fix",
        "rector": "./vendor/bin/rector process src",
        "static": "./vendor/bin/phpstan analyse src --memory-limit=-1",
        "tests": "./vendor/bin/phpunit"
    }
}
